{
  "expo": {
    "name": "GoldLedger",
    "slug": "goldledger",
    "scheme": "goldledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldledger.app"
    },
    "android": {
      "package": "com.goldledger.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoldLedger uses photos only when you add an image to a customer gallery.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-local-authentication",
      "expo-sharing",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "493496a7-d391-4882-a61d-5e25875e6642"
      }
    }
  }
}
